# ==========================================
# Neon Database Connection Configuration
# ==========================================
# 1. DATABASE_URL: Pooled connection for high-concurrency serverless queries (uses Neon PgBouncer pooler).
# Format: postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# 2. DIRECT_URL: Direct unpooled connection required for Prisma migrations and schema push.
# Format: postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==========================================
# Authentication & Security Secrets
# ==========================================
# Strong random 32+ character string used to cryptographically sign session cookies (HMAC-SHA256)
SESSION_SECRET="change-this-to-a-cryptographically-secure-random-string-min-32-chars"

# Optional fallback admin token
ADMIN_TOKEN=""

# Node Environment
NODE_ENV="development"

# ==========================================
# Cloudinary (Image Uploads)
# ==========================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
